#!/usr/bin/env bash
# vm-create — provision a new KVM VM from the ubuntu-base cloud image
# Usage: vm-create --name <name> [--ram <mb>] [--cpus <n>] [--disk <size>]

set -euo pipefail

# ── Defaults ────────────────────────────────────────────────────────────────
VM_NAME=""
RAM_MB=8192
VCPUS=4
DISK_SIZE="20G"

ZFS_BASE="tank/vms/ubuntu-base@ready"
ZFS_VMS="tank/vms"
BRIDGE="br-enp2s0"
SEED_TEMPLATE="$HOME/vm-init/user-data"
META_TEMPLATE="$HOME/vm-init/meta-data"
CLOUD_INIT_DIR="/var/lib/libvirt/cloud-init"
SSH_KEY="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJST7uGpGw3RStcmqJHA4WvyVKx++WtcJJdOpPMAekQI dylan@sim-server"

# ── Colours ─────────────────────────────────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; NC='\033[0m'
info()    { echo -e "${CYAN}[vm-create]${NC} $*"; }
success() { echo -e "${GREEN}[vm-create]${NC} $*"; }
warn()    { echo -e "${YELLOW}[vm-create]${NC} $*"; }
die()     { echo -e "${RED}[vm-create] ERROR:${NC} $*" >&2; exit 1; }

# ── Usage ────────────────────────────────────────────────────────────────────
usage() {
  cat <<EOF
Usage: vm-create --name <name> [OPTIONS]

Options:
  --name   <name>   VM name (required) — also becomes the hostname
  --ram    <mb>     RAM in MB         (default: ${RAM_MB})
  --cpus   <n>      vCPU count        (default: ${VCPUS})
  --disk   <size>   ZFS zvol size     (default: ${DISK_SIZE})
  --help            Show this help

Examples:
  vm-create --name myservice
  vm-create --name bigvm --ram 16384 --cpus 8 --disk 100G
EOF
  exit 0
}

# ── Arg parsing ──────────────────────────────────────────────────────────────
[[ $# -eq 0 ]] && usage
while [[ $# -gt 0 ]]; do
  case $1 in
    --name)  VM_NAME="$2";  shift 2 ;;
    --ram)   RAM_MB="$2";   shift 2 ;;
    --cpus)  VCPUS="$2";    shift 2 ;;
    --disk)  DISK_SIZE="$2"; shift 2 ;;
    --help)  usage ;;
    *) die "Unknown option: $1" ;;
  esac
done

[[ -z "$VM_NAME" ]] && die "--name is required"

# ── Validate ─────────────────────────────────────────────────────────────────
sudo zfs list "${ZFS_BASE%@*}" &>/dev/null || die "Base zvol not found: ${ZFS_BASE%@*}"
sudo zfs list "${ZFS_BASE%@*}@${ZFS_BASE#*@}" &>/dev/null || die "Base snapshot not found: ${ZFS_BASE}"
sudo virsh dominfo "$VM_NAME" &>/dev/null && die "VM '$VM_NAME' already exists in libvirt"
sudo zfs list "${ZFS_VMS}/${VM_NAME}" &>/dev/null && die "ZFS dataset ${ZFS_VMS}/${VM_NAME} already exists"
[[ -f "$SEED_TEMPLATE" ]] || die "user-data template not found: $SEED_TEMPLATE"

# ── Summary ──────────────────────────────────────────────────────────────────
echo ""
info "Creating VM: ${VM_NAME}"
info "  RAM:  ${RAM_MB} MB"
info "  CPUs: ${VCPUS}"
info "  Disk: ${DISK_SIZE} (ZFS clone of ${ZFS_BASE})"
echo ""

# ── Step 1: Clone ZFS snapshot ───────────────────────────────────────────────
info "Cloning ${ZFS_BASE} → ${ZFS_VMS}/${VM_NAME} ..."
sudo zfs clone "${ZFS_BASE}" "${ZFS_VMS}/${VM_NAME}"

# ── Step 2: Generate per-VM seed ISO ────────────────────────────────────────
info "Generating cloud-init seed ISO for hostname '${VM_NAME}' ..."
WORK_DIR=$(mktemp -d)
trap 'rm -rf "$WORK_DIR"' EXIT

# user-data: swap in the correct hostname
cat "$SEED_TEMPLATE" > "${WORK_DIR}/user-data"

# meta-data: set hostname to VM name
cat > "${WORK_DIR}/meta-data" <<EOF
instance-id: ${VM_NAME}
local-hostname: ${VM_NAME}
EOF

SEED_ISO="${CLOUD_INIT_DIR}/${VM_NAME}-seed.iso"
cloud-localds "${WORK_DIR}/seed.iso" "${WORK_DIR}/user-data" "${WORK_DIR}/meta-data"
sudo cp "${WORK_DIR}/seed.iso" "${SEED_ISO}"

# ── Step 3: Boot the VM ──────────────────────────────────────────────────────
info "Starting virt-install ..."
sudo virt-install \
  --name "${VM_NAME}" \
  --ram "${RAM_MB}" \
  --vcpus "${VCPUS}" \
  --disk path="/dev/zvol/${ZFS_VMS}/${VM_NAME}",format=raw,bus=virtio \
  --disk path="${SEED_ISO}",device=cdrom \
  --os-variant ubuntu24.04 \
  --network bridge="${BRIDGE}",model=virtio \
  --graphics none \
  --console pty,target_type=serial \
  --boot uefi \
  --import \
  --noautoconsole

# ── Step 4: Wait for SSH to come up ─────────────────────────────────────────
info "Waiting for SSH to become available ..."

# Get the VM's MAC address from libvirt
MAC=$(sudo virsh domiflist "${VM_NAME}" 2>/dev/null \
  | awk '/bridge/ {print $5}' | head -1) || true
info "VM MAC address: ${MAC:-unknown}"

VM_HOST="${VM_NAME}.home.nthparallel.com"
ELAPSED=0
TIMEOUT=180
SSH_UP=false
info "Waiting for ${VM_HOST} to become reachable ..."
while [[ $ELAPSED -lt $TIMEOUT ]]; do
  sleep 5
  ELAPSED=$((ELAPSED + 5))
  if ssh -o StrictHostKeyChecking=no -o ConnectTimeout=3 -o BatchMode=yes \
      "dylan@${VM_HOST}" true 2>/dev/null; then
    SSH_UP=true
    break
  fi
  echo -ne "\r  ${ELAPSED}s elapsed..."
done
echo ""

if [[ "$SSH_UP" == "false" ]]; then
  warn "Could not reach ${VM_HOST} via SSH after ${TIMEOUT}s."
  warn "Once reachable, run: ssh dylan@${VM_HOST} 'cloud-init status --wait && sudo reboot'"
else
  info "SSH is up — waiting for cloud-init to finish ..."
  ssh -o StrictHostKeyChecking=no "dylan@${VM_HOST}" "cloud-init status --wait" 2>/dev/null || true
  info "Cloud-init done — rebooting so guest agent starts cleanly ..."
  ssh -o StrictHostKeyChecking=no "dylan@${VM_HOST}" "sudo reboot" 2>/dev/null || true
  sleep 20
fi

# ── Step 5: Get final IP via guest agent ─────────────────────────────────────
info "Waiting for guest agent after reboot ..."
TIMEOUT=60
ELAPSED=0
IP=""
while [[ $ELAPSED -lt $TIMEOUT ]]; do
  sleep 5
  ELAPSED=$((ELAPSED + 5))
  IP=$(sudo virsh domifaddr "${VM_NAME}" --source agent 2>/dev/null \
    | awk '/ipv4/ && !/127\.0\.0/ {print $4}' \
    | cut -d/ -f1 | head -1) || true
  if [[ -n "$IP" ]]; then
    break
  fi
  echo -ne "\r  ${ELAPSED}s elapsed..."
done
echo ""

# ── Step 6: Take a fresh snapshot ───────────────────────────────────────────
info "Taking post-cloud-init snapshot: ${ZFS_VMS}/${VM_NAME}@fresh ..."
sudo zfs snapshot "${ZFS_VMS}/${VM_NAME}@fresh"

# ── Step 7: Set autostart ────────────────────────────────────────────────────
info "Enabling autostart on host boot ..."
sudo virsh autostart "${VM_NAME}"

# ── Done ─────────────────────────────────────────────────────────────────────
echo ""
success "VM '${VM_NAME}' is ready!"
echo ""
if [[ -n "$IP" ]]; then
  success "  IP address:  ${IP}"
  success "  SSH:         ssh dylan@${VM_HOST}"
else
  warn "  Could not detect IP via guest agent."
  warn "  SSH:         ssh dylan@${VM_HOST} (once DNS propagates)"
  warn "  Or check:    sudo virsh domifaddr ${VM_NAME} --source agent"
fi
echo ""
warn "Remaining manual steps:"
warn "  1. OPNsense → Services → DHCPv4 → Leases → assign static lease for ${VM_NAME} (MAC: ${MAC:-check virsh domiflist})"
warn "  2. If public access needed: add Caddy reverse proxy entry + Cloudflare tunnel route"
warn "  Note: ${VM_NAME}.home.nthparallel.com resolves automatically via Unbound dynamic DNS"
echo ""
